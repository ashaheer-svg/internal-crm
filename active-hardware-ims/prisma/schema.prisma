generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                 String   @id @default(uuid())
  name               String
  email              String   @unique
  password           String   // bcrypt hashed
  role               String   // ADMIN, MANAGER, SALES, WAREHOUSE, VIEWER
  isActive           Boolean  @default(true)
  mustChangePassword Boolean  @default(false)
  lastLoginAt        DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  createdBy          String?
  
  // Relations
  reservations  Reservation[]
  auditLogs     AuditLog[]
  sessions      Session[]
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  
  @@index([userId])
  @@index([token])
}

model AuditLog {
  id         String   @id @default(uuid())
  action     String   // CREATE, UPDATE, DELETE, LOGIN, LOGOUT
  entityType String   // USER, PRODUCT, INVOICE, CUSTOMER, INVENTORY, etc.
  entityId   String?  // ID of affected entity
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  userName   String   // Cached for display
  changes    String?  // JSON string of before/after values
  metadata   String?  // JSON string of additional context
  createdAt  DateTime @default(now())
  
  @@index([entityType, entityId])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model Customer {
  id          String   @id @default(uuid())
  name        String
  contactName String?  // Contact person name
  email       String?
  phone       String?
  address     String?
  taxId       String?  // Tax/VAT ID
  salesRep    String?  // Sales representative
  notes       String?
  // Roles (Multi-select)
  isCustomer  Boolean  @default(false) // End Customer
  isSupplier  Boolean  @default(false) // Supplier
  isPartner   Boolean  @default(false) // Partner (e.g. Reseller)
  
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  invoices    Invoice[]
  deliveryOrders DeliveryOrder[]
  deliveryAddresses DeliveryAddress[]
  employees   PartnerEmployee[]
}

model PartnerEmployee {
  id          String   @id @default(uuid())
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  name        String
  designation String?  // e.g. Salesrep, Accounts
  email       String?
  phone       String?
  isActive    Boolean  @default(true) // For soft delete
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([customerId])
}

model DeliveryAddress {
  id          String   @id @default(uuid())
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  label       String   // e.g. "Main Warehouse", "Branch A"
  address     String   // Full address
  contactName String?
  phone       String?
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([customerId])
}

model Product {
  id          String   @id @default(uuid())
  sku         String   @unique
  name        String
  description String?
  brand       String
  category    String   @default("General")
  model       String
  minStock    Int      @default(0)
  warrantyMonths Int   @default(0)
  lowResellerPrice Float @default(0)
  resellerPrice    Float @default(0)
  isActive         Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  inventory   InventoryItem[]
  purchaseOrderItems PurchaseOrderItem[]
  invoiceItems InvoiceItem[]
  backorderItems BackorderItem[]
  deliveryOrderItems DeliveryOrderItem[]
}

model Location {
  id        String   @id @default(uuid())
  name      String
  type      String   // PHYSICAL, VIRTUAL
  address   String?
  createdAt DateTime @default(now())
  inventory InventoryItem[]
}

model InventoryItem {
  id              String   @id @default(uuid())
  serialNumber    String   @unique
  productId       String
  product         Product  @relation(fields: [productId], references: [id])
  locationId      String
  location        Location @relation(fields: [locationId], references: [id])
  status          String   // AVAILABLE, RESERVED, DEFECTIVE, SOLD, RMA
  unitCost        Float    @default(0) // Cost per unit for average costing
  warrantyExpiry  DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  warrantyClaims  WarrantyClaim[]
  reservations    Reservation[]
  
  // Delivery Order Reservation
  deliveryOrderItemId String?
  deliveryOrderItem   DeliveryOrderItem? @relation(fields: [deliveryOrderItemId], references: [id])
}

model Reservation {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  inventoryItemId String
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id])
  expiry          DateTime
  createdAt       DateTime @default(now())
}

model WarrantyClaim {
  id              String   @id @default(uuid())
  inventoryItemId String
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id])
  customerName    String
  description     String
  status          String   // PENDING, SENT_TO_VENDOR, REPAIRED, RETURNED
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model GoodsReceiptNote {
  id          String   @id @default(uuid())
  grnNumber   String   @unique
  supplier    String
  poReference String?
  receivedBy  String
  notes       String?
  status      String   @default("DRAFT")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  items       GRNItem[]
}

model GRNItem {
  id              String   @id @default(uuid())
  grnId           String
  grn             GoodsReceiptNote @relation(fields: [grnId], references: [id], onDelete: Cascade)
  productId       String
  serialNumbers   String
  quantity        Int
  unitCost        Float
  locationId      String
  createdAt       DateTime @default(now())
}


model PurchaseOrder {
  id              String   @id @default(uuid())
  poNumber        String   @unique
  supplier        String
  totalAmount     Float    @default(0)
  status          String   // DRAFT, SUBMITTED, RECEIVED, CANCELLED
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  items           PurchaseOrderItem[]
}

model PurchaseOrderItem {
  id              String   @id @default(uuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  productId       String
  product         Product  @relation(fields: [productId], references: [id])
  quantity        Int
  unitCost        Float
  totalCost       Float
  receivedQty     Int      @default(0)
  createdAt       DateTime @default(now())
}

model Invoice {
  id              String   @id @default(uuid())
  invoiceNumber   String   @unique
  customerInvoiceRef String?  // Customer's invoice number reference
  customerId      String?
  customer        Customer? @relation(fields: [customerId], references: [id])
  customerName    String
  customerEmail   String?
  customerPhone   String?
  totalAmount     Float    @default(0)
  status          String   // DRAFT, ISSUED, PAID, CANCELLED
  hasBackorders   Boolean  @default(false)
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  items           InvoiceItem[]
  backorderItems  BackorderItem[]
}

model InvoiceItem {
  id              String   @id @default(uuid())
  invoiceId       String
  invoice         Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  
  // Optional inventory item (null for out-of-stock items)
  inventoryItemId String?
  
  // Product reference for all items
  productId       String
  product         Product  @relation(fields: [productId], references: [id])
  
  // Item details
  productName     String   // Snapshot for historical record
  serialNumber    String?  // Null for out-of-stock items
  unitPrice       Float
  quantity        Int      @default(1)
  
  // Fulfillment tracking
  isFulfilled     Boolean  @default(true)  // False for backorder items
  fulfilledAt     DateTime?
  
  createdAt       DateTime @default(now())
  backorderItem   BackorderItem?
}

model BackorderItem {
  id                String   @id @default(uuid())
  invoiceId         String
  invoice           Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceItemId     String   @unique
  invoiceItem       InvoiceItem @relation(fields: [invoiceItemId], references: [id], onDelete: Cascade)
  
  productId         String
  product           Product  @relation(fields: [productId], references: [id])
  
  quantityOrdered   Int
  quantityFulfilled Int      @default(0)
  status            String   // PENDING, PARTIAL, FULFILLED, CANCELLED
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model TransactionLog {
  id              String   @id @default(uuid())
  type            String   // RECEIPT, ISSUE, TRANSFER, ADJUSTMENT
  referenceType   String?  // PO, INVOICE, TRANSFER
  referenceId     String?
  productId       String?
  serialNumber    String?
  quantity        Int      @default(1)
  fromLocation    String?
  toLocation      String?
  unitCost        Float?
  performedBy     String?  // User who performed the action
  notes           String?
  createdAt       DateTime @default(now())
}

model Category {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Sequence {
  id            String   @id // "PO", "GRN"
  nextNumber    Int      @default(1)
  lastYearMonth String?  // "YYMM" to track month changes
  prefix        String   // "PO-", "GRN-"
  updatedAt     DateTime @updatedAt
}

model DeliveryOrder {
  id            String   @id @default(uuid())
  orderNumber   String   @unique
  customerId    String?
  customer      Customer? @relation(fields: [customerId], references: [id])
  customerName  String
  deliveryAddress String? // Snapshot of delivery address
  status        String   @default("DRAFT") // DRAFT, CONFIRMED, COMPLETED, CANCELLED
  totalAmount   Float    @default(0)
  invoiceValue  Float    @default(0) // Revenue (Excl. Tax)
  additionalCosts Float  @default(0) // Overhead/Shipping/etc.
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  isActive      Boolean  @default(true)
  items         DeliveryOrderItem[]
}

model DeliveryOrderItem {
  id              String   @id @default(uuid())
  deliveryOrderId String
  deliveryOrder   DeliveryOrder @relation(fields: [deliveryOrderId], references: [id], onDelete: Cascade)
  productId       String
  product         Product  @relation(fields: [productId], references: [id])
  quantity        Int      // Target quantity
  unitPrice       Float
  isBackorder     Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Reservation link
  reservedItems   InventoryItem[]
}


