generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                    String                 @id @default(uuid())
  name                  String
  email                 String                 @unique
  password              String
  isActive              Boolean                @default(true)
  mustChangePassword    Boolean                @default(false)
  lastLoginAt           DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  createdBy             String?
  roleId                String?
  legacyRole            String?                @map("role")
  salesRepId            String?
  auditLogs             AuditLog[]
  crmActivities         CRMActivity[]
  createdQuotes         CRMQuote[]
  builtOrders           DeliveryOrder[]        @relation("BuiltBy")
  receivedMessages      Message[]              @relation("ReceivedMessages")
  sentMessages          Message[]              @relation("SentMessages")
  messageReceipts       MessageReceipt[]
  pendingProjectImports PendingProjectImport[]
  projectMemberships    ProjectMember[]
  createdTasks          ProjectTask[]          @relation("TaskCreator")
  assignedTasks         ProjectTask[]          @relation("TaskAssignee")
  reservations          Reservation[]
  sessions              Session[]
  salesRep              SalesRep?              @relation(fields: [salesRepId], references: [id])
  role                  Role?                  @relation(fields: [roleId], references: [id])
  resolvedClaims        WarrantyClaim[]
}

model Role {
  id              String           @id @default(uuid())
  name            String           @unique
  description     String?
  isSystemDefault Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  messages        Message[]
  projectTasks    ProjectTask[]
  permissions     RolePermission[]
  users           User[]
}

model Permission {
  id          String           @id @default(uuid())
  action      String
  resource    String
  description String?
  roles       RolePermission[]

  @@unique([action, resource])
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  permissionId String
  assignedAt   DateTime   @default(now())
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model AuditLog {
  id         String   @id @default(uuid())
  action     String
  entityType String
  entityId   String?
  userId     String?
  userName   String
  changes    String?
  metadata   String?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id])

  @@index([entityType, entityId])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model Customer {
  id                        String            @id @default(uuid())
  name                      String
  contactName               String?
  email                     String?
  phone                     String?
  address                   String?
  taxId                     String?
  salesRepLegacy            String?
  notes                     String?
  isCustomer                Boolean           @default(false)
  isSupplier                Boolean           @default(false)
  isPartner                 Boolean           @default(false)
  isActive                  Boolean           @default(true)
  createdAt                 DateTime          @default(now())
  updatedAt                 DateTime          @updatedAt
  salesRepId                String?
  partnerProjects           CRMProject[]      @relation("ProjectPartner")
  crmProjects               CRMProject[]
  quotedShipTo              CRMQuote[]        @relation("QuoteShipTo")
  quotedBillTo              CRMQuote[]        @relation("QuoteBillTo")
  salesRep                  SalesRep?         @relation(fields: [salesRepId], references: [id])
  deliveryAddresses         DeliveryAddress[]
  endCustomerDeliveryOrders DeliveryOrder[]   @relation("EndCustomer")
  deliveryOrders            DeliveryOrder[]
  invoices                  Invoice[]
  employees                 PartnerEmployee[]
  partnerContracts          ServiceContract[] @relation("PartnerLink")
  serviceContracts          ServiceContract[]
  supplierRmas              SupplierRMA[]
  warrantyClaims            WarrantyClaim[]
}

model SalesRep {
  id               String            @id @default(uuid())
  name             String
  email            String?
  phone            String?
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  crmProjects      CRMProject[]
  customers        Customer[]
  deliveryOrders   DeliveryOrder[]
  invoices         Invoice[]
  serviceContracts ServiceContract[]
  users            User[]
}

model PartnerEmployee {
  id          String   @id @default(uuid())
  customerId  String
  name        String
  designation String?
  email       String?
  phone       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

model DeliveryAddress {
  id          String   @id @default(uuid())
  customerId  String
  label       String
  address     String
  contactName String?
  phone       String?
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

model Product {
  id                 String              @id @default(uuid())
  sku                String              @unique
  name               String
  description        String?
  brand              String
  category           String              @default("General")
  model              String
  minStock           Int                 @default(0)
  warrantyMonths     Int                 @default(0)
  lowResellerPrice   Float               @default(0)
  resellerPrice      Float               @default(0)
  accessCount        Int                 @default(0)
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  backorderItems     BackorderItem[]
  quoteItems         CRMQuoteItem[]
  deliveryOrderItems DeliveryOrderItem[]
  grnItems           GRNItem[]
  inventory          InventoryItem[]
  invoiceItems       InvoiceItem[]
  nasCompatibility   NasCompatibility[]
  purchaseOrderItems PurchaseOrderItem[]
  rentalAssets       RentalAsset[]
  serviceContracts   ServiceContract[]
  serviceDefinition  ServiceDefinition?
}

model Location {
  id        String          @id @default(uuid())
  name      String
  type      String
  address   String?
  createdAt DateTime        @default(now())
  inventory InventoryItem[]
}

model InventoryItem {
  id                      String             @id @default(uuid())
  serialNumber            String             @unique
  productId               String
  locationId              String
  status                  String
  unitCost                Float              @default(0)
  warrantyExpiry          DateTime?
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt
  deliveryOrderItemId     String?
  warrantyClaimId         String?
  warrantyClaim           WarrantyClaim?     @relation("ItemWarrantyClaim", fields: [warrantyClaimId], references: [id])
  deliveryOrderItem       DeliveryOrderItem? @relation(fields: [deliveryOrderItemId], references: [id])
  location                Location           @relation(fields: [locationId], references: [id])
  product                 Product            @relation(fields: [productId], references: [id])
  reservations            Reservation[]
  supplierRmasAsReceived  SupplierRMA?       @relation("ReceivedFromSupplierRMA")
  supplierRmasAsDefective SupplierRMA[]      @relation("DefectiveInSupplierRMA")
  warrantyClaims          WarrantyClaim[]

  @@index([productId, status])
}

model Reservation {
  id              String        @id @default(uuid())
  userId          String
  inventoryItemId String
  expiry          DateTime
  createdAt       DateTime      @default(now())
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id])
  user            User          @relation(fields: [userId], references: [id])
}

model WarrantyClaim {
  id                      String          @id @default(uuid())
  inventoryItemId         String
  customerId              String?
  customerName            String
  description             String
  status                  String
  replacementType         String?
  replacementItemId       String?
  replacementProvidedAt   DateTime?
  replacementReturnedAt   DateTime?
  replacementExternalInfo String?
  supplierRmaId           String?
  resolution              String?
  resolvedAt              DateTime?
  resolvedById            String?
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt
  tiedItems               InventoryItem[] @relation("ItemWarrantyClaim")
  resolvedBy              User?           @relation(fields: [resolvedById], references: [id])
  supplierRma             SupplierRMA?    @relation(fields: [supplierRmaId], references: [id])
  customer                Customer?       @relation(fields: [customerId], references: [id])
  inventoryItem           InventoryItem   @relation(fields: [inventoryItemId], references: [id])
}

model SupplierRMA {
  id              String          @id @default(uuid())
  rmaNumber       String          @unique
  defectiveItemId String?
  supplierId      String
  supplierRmaRef  String?
  shippedAt       DateTime?
  notes           String?
  outcome         String?
  outcomeNotes    String?
  resolvedAt      DateTime?
  receivedItemId  String?         @unique
  creditNoteRef   String?
  creditNoteValue Float?
  status          String
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  receivedItem    InventoryItem?  @relation("ReceivedFromSupplierRMA", fields: [receivedItemId], references: [id])
  supplier        Customer        @relation(fields: [supplierId], references: [id])
  defectiveItem   InventoryItem?  @relation("DefectiveInSupplierRMA", fields: [defectiveItemId], references: [id])
  warrantyClaims  WarrantyClaim[]
}

model GoodsReceiptNote {
  id          String    @id @default(uuid())
  grnNumber   String    @unique
  supplier    String
  poReference String?
  receivedBy  String
  notes       String?
  status      String    @default("DRAFT")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  items       GRNItem[]
}

model GRNItem {
  id            String           @id @default(uuid())
  grnId         String
  productId     String
  serialNumbers String
  quantity      Int
  unitCost      Float
  locationId    String
  createdAt     DateTime         @default(now())
  product       Product          @relation(fields: [productId], references: [id])
  grn           GoodsReceiptNote @relation(fields: [grnId], references: [id], onDelete: Cascade)
}

model PurchaseOrder {
  id          String              @id @default(uuid())
  poNumber    String              @unique
  supplier    String
  totalAmount Float               @default(0)
  status      String
  notes       String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  items       PurchaseOrderItem[]
}

model PurchaseOrderItem {
  id              String        @id @default(uuid())
  purchaseOrderId String
  productId       String
  quantity        Int
  unitCost        Float
  totalCost       Float
  receivedQty     Int           @default(0)
  createdAt       DateTime      @default(now())
  product         Product       @relation(fields: [productId], references: [id])
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])

  @@index([productId, createdAt])
}

model Invoice {
  id                 String          @id @default(uuid())
  invoiceNumber      String          @unique
  customerInvoiceRef String?
  customerId         String?
  customerName       String
  customerEmail      String?
  customerPhone      String?
  totalAmount        Float           @default(0)
  status             String
  hasBackorders      Boolean         @default(false)
  notes              String?
  salesRepId         String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  backorderItems     BackorderItem[]
  salesRep           SalesRep?       @relation(fields: [salesRepId], references: [id])
  customer           Customer?       @relation(fields: [customerId], references: [id])
  items              InvoiceItem[]
}

model InvoiceItem {
  id              String           @id @default(uuid())
  invoiceId       String
  inventoryItemId String?
  productId       String
  productName     String
  serialNumber    String?
  unitPrice       Float
  quantity        Int              @default(1)
  isFulfilled     Boolean          @default(true)
  fulfilledAt     DateTime?
  createdAt       DateTime         @default(now())
  backorderItem   BackorderItem?
  product         Product          @relation(fields: [productId], references: [id])
  invoice         Invoice          @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  serviceContract ServiceContract?
}

model BackorderItem {
  id                 String              @id @default(uuid())
  invoiceId          String
  invoiceItemId      String              @unique
  productId          String
  quantityOrdered    Int
  quantityFulfilled  Int                 @default(0)
  status             String
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  product            Product             @relation(fields: [productId], references: [id])
  invoiceItem        InvoiceItem         @relation(fields: [invoiceItemId], references: [id], onDelete: Cascade)
  invoice            Invoice             @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  deliveryOrderItems DeliveryOrderItem[]
}

model TransactionLog {
  id            String   @id @default(uuid())
  type          String
  referenceType String?
  referenceId   String?
  productId     String?
  serialNumber  String?
  quantity      Int      @default(1)
  fromLocation  String?
  toLocation    String?
  unitCost      Float?
  performedBy   String?
  notes         String?
  createdAt     DateTime @default(now())
}

model Category {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Sequence {
  id            String   @id
  nextNumber    Int      @default(1)
  lastYearMonth String?
  prefix        String
  updatedAt     DateTime @updatedAt
}

model DeliveryOrder {
  id                   String              @id @default(uuid())
  orderNumber          String              @unique
  deliveryAddress      String?
  saleType             String              @default("DIRECT")
  customerId           String?
  customerName         String
  endCustomerId        String?
  endCustomerName      String?
  status               String              @default("DRAFT")
  totalAmount          Float               @default(0)
  invoiceValue         Float               @default(0)
  invoiceNumber        String?
  additionalCosts      Float               @default(0)
  notes                String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  isActive             Boolean             @default(true)
  quoteReference       String?
  salesRepId           String?
  builtById            String?
  buildNotes           String?
  builtAt              DateTime?
  buildInstructions    String?
  deliveryInstructions String?
  additionalContact    String?
  deliveryCharges      Float               @default(0)
  buildRejections      BuildRejection[]
  quotes               CRMQuote[]
  builtBy              User?               @relation("BuiltBy", fields: [builtById], references: [id])
  salesRep             SalesRep?           @relation(fields: [salesRepId], references: [id])
  endCustomer          Customer?           @relation("EndCustomer", fields: [endCustomerId], references: [id])
  customer             Customer?           @relation(fields: [customerId], references: [id])
  items                DeliveryOrderItem[]
}

model DeliveryOrderItem {
  id                String                    @id @default(uuid())
  deliveryOrderId   String
  productId         String
  quantity          Int
  unitPrice         Float
  isBackorder       Boolean                   @default(false)
  quantityFulfilled Int                       @default(0)
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  backorderItemId   String?
  serviceEndDate    DateTime?
  serviceStartDate  DateTime?
  unitCost          Float?
  backorderItem     BackorderItem?            @relation(fields: [backorderItemId], references: [id])
  product           Product                   @relation(fields: [productId], references: [id])
  deliveryOrder     DeliveryOrder             @relation(fields: [deliveryOrderId], references: [id], onDelete: Cascade)
  details           DeliveryOrderItemDetail[]
  reservedItems     InventoryItem[]
}

model DeliveryOrderItemDetail {
  id                  String            @id @default(uuid())
  deliveryOrderItemId String
  modelName           String
  serialNumbers       String
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  deliveryOrderItem   DeliveryOrderItem @relation(fields: [deliveryOrderItemId], references: [id], onDelete: Cascade)
}

model ServiceDefinition {
  id            String   @id @default(uuid())
  productId     String   @unique
  type          String
  durationValue Int      @default(1)
  durationUnit  String   @default("YEAR")
  isMetered     Boolean  @default(false)
  billingCycle  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  product       Product  @relation(fields: [productId], references: [id])
}

model ServiceContract {
  id                 String                @id @default(uuid())
  customerId         String
  productId          String
  invoiceItemId      String?               @unique
  startDate          DateTime?
  endDate            DateTime?
  status             String                @default("PENDING")
  previousContractId String?               @unique
  durationValue      Int                   @default(1)
  durationUnit       String                @default("YEAR")
  licenseKey         String?
  description        String?
  contractNumber     String?               @unique
  contractValue      Float                 @default(0)
  unitCost           Float                 @default(0)
  invoiceReference   String?
  partnerId          String?
  salesRepId         String?
  isDeleted          Boolean               @default(false)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  coveredSerials     String?
  productModel       String?
  rentalAssets       RentalAsset[]         @relation("ActiveRental")
  salesRep           SalesRep?             @relation(fields: [salesRepId], references: [id])
  partner            Customer?             @relation("PartnerLink", fields: [partnerId], references: [id])
  previousContract   ServiceContract?      @relation("RenewalHistory", fields: [previousContractId], references: [id])
  nextContract       ServiceContract?      @relation("RenewalHistory")
  invoiceItem        InvoiceItem?          @relation(fields: [invoiceItemId], references: [id])
  product            Product               @relation(fields: [productId], references: [id])
  customer           Customer              @relation(fields: [customerId], references: [id])
  items              ServiceContractItem[]
}

model ServiceContractItem {
  id                String          @id @default(uuid())
  serviceContractId String
  modelName         String
  serialNumbers     String
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  serviceContract   ServiceContract @relation(fields: [serviceContractId], references: [id], onDelete: Cascade)

  @@index([serviceContractId])
}

model RentalAsset {
  id                String           @id @default(uuid())
  name              String
  serialNumber      String           @unique
  productId         String?
  status            String           @default("AVAILABLE")
  currentContractId String?
  isDeleted         Boolean          @default(false)
  notes             String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  currentContract   ServiceContract? @relation("ActiveRental", fields: [currentContractId], references: [id])
  product           Product?         @relation(fields: [productId], references: [id])
}

model CRMPipeline {
  id        String       @id @default(uuid())
  name      String
  isDefault Boolean      @default(false)
  projects  CRMProject[]
  stages    CRMStage[]
}

model CRMStage {
  id         String       @id @default(uuid())
  name       String
  order      Int
  color      String?
  pipelineId String
  projects   CRMProject[]
  pipeline   CRMPipeline  @relation(fields: [pipelineId], references: [id])
}

model CRMProject {
  id                String          @id @default(uuid())
  projectCode       String          @unique
  title             String
  description       String?
  status            String
  probability       Int             @default(0)
  expectedValue     Float           @default(0)
  currency          String          @default("INR")
  startDate         DateTime        @default(now())
  targetDate        DateTime?
  closedAt          DateTime?
  stageId           String
  pipelineId        String
  customerId        String
  partnerId         String?
  salesRepId        String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  isDeleted         Boolean         @default(false)
  expectedCloseDate DateTime?
  brand             String?
  activities        CRMActivity[]
  salesRep          SalesRep?       @relation(fields: [salesRepId], references: [id])
  partner           Customer?       @relation("ProjectPartner", fields: [partnerId], references: [id])
  customer          Customer        @relation(fields: [customerId], references: [id])
  pipeline          CRMPipeline     @relation(fields: [pipelineId], references: [id])
  stage             CRMStage        @relation(fields: [stageId], references: [id])
  quotes            CRMQuote[]
  members           ProjectMember[]
  tasks             ProjectTask[]
}

model ProjectMember {
  id        String     @id @default(uuid())
  projectId String
  userId    String
  role      String
  joinedAt  DateTime   @default(now())
  user      User       @relation(fields: [userId], references: [id])
  project   CRMProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
}

model ProjectTask {
  id               String     @id @default(uuid())
  title            String
  description      String?
  status           String
  priority         String
  dueDate          DateTime?
  projectId        String
  assignedToId     String?
  assignedToRoleId String?
  createdById      String
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  attachmentUrl    String?
  createdBy        User       @relation("TaskCreator", fields: [createdById], references: [id])
  assignedToRole   Role?      @relation(fields: [assignedToRoleId], references: [id])
  assignedTo       User?      @relation("TaskAssignee", fields: [assignedToId], references: [id])
  project          CRMProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model CRMActivity {
  id          String     @id @default(uuid())
  type        String
  subject     String
  content     String?
  outcome     String?
  projectId   String
  createdById String
  createdAt   DateTime   @default(now())
  createdBy   User       @relation(fields: [createdById], references: [id])
  project     CRMProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model CRMQuote {
  id                   String         @id @default(uuid())
  quoteNumber          String         @unique
  version              Int            @default(1)
  status               String
  validUntil           DateTime?
  terms                String?
  subTotal             Float
  taxAmount            Float
  taxDetails           String?
  discount             Float          @default(0)
  totalAmount          Float
  projectId            String
  templateId           String?
  poNumber             String?
  poDocumentUrl        String?
  expectedDeliveryDate DateTime?
  urgency              String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  createdById          String
  deliveryOrderId      String?
  saleType             String         @default("DIRECT")
  billToId             String?
  shipToId             String?
  shipTo               Customer?      @relation("QuoteShipTo", fields: [shipToId], references: [id])
  billTo               Customer?      @relation("QuoteBillTo", fields: [billToId], references: [id])
  deliveryOrder        DeliveryOrder? @relation(fields: [deliveryOrderId], references: [id])
  createdBy            User           @relation(fields: [createdById], references: [id])
  project              CRMProject     @relation(fields: [projectId], references: [id])
  items                CRMQuoteItem[]
}

model CRMQuoteItem {
  id            String               @id @default(uuid())
  quoteId       String
  order         Int
  productId     String?
  description   String
  quantity      Int
  unitPrice     Float
  discount      Float                @default(0)
  taxRate       Float                @default(0)
  total         Float
  productModel  String?
  serialNumbers String?
  product       Product?             @relation(fields: [productId], references: [id])
  quote         CRMQuote             @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  details       CRMQuoteItemDetail[]
}

model CRMQuoteItemDetail {
  id            String       @id @default(uuid())
  quoteItemId   String
  modelName     String
  serialNumbers String
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  quoteItem     CRMQuoteItem @relation(fields: [quoteItemId], references: [id], onDelete: Cascade)

  @@index([quoteItemId])
}

model TaxConfiguration {
  id        String   @id @default(uuid())
  name      String
  rate      Float
  type      String   @default("PERCENTAGE")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SystemSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Message {
  id                  String              @id @default(uuid())
  subject             String
  content             String
  category            String              @default("GENERAL")
  priority            String              @default("MEDIUM")
  deadline            DateTime?
  isSystemGenerated   Boolean             @default(false)
  senderId            String?
  recipientUserId     String?
  recipientRoleId     String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  customerName        String?
  deliveryOrderNumber String?
  invoiceNumber       String?
  partnerName         String?
  recipientRole       Role?               @relation(fields: [recipientRoleId], references: [id])
  recipientUser       User?               @relation("ReceivedMessages", fields: [recipientUserId], references: [id])
  sender              User?               @relation("SentMessages", fields: [senderId], references: [id], onDelete: SetNull)
  attachments         MessageAttachment[]
  receipts            MessageReceipt[]

  @@index([senderId])
  @@index([recipientUserId])
  @@index([recipientRoleId])
}

model MessageAttachment {
  id        String   @id @default(uuid())
  messageId String
  fileName  String
  filePath  String
  fileType  String
  fileSize  Int
  createdAt DateTime @default(now())
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
}

model MessageReceipt {
  id        String    @id @default(uuid())
  messageId String
  userId    String
  viewedAt  DateTime?
  isDone    Boolean   @default(false)
  doneAt    DateTime?
  comment   String?
  user      User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  message   Message   @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([messageId])
  @@index([userId])
}

model PendingProjectImport {
  id           String   @id @default(uuid())
  date         String
  customerName String
  partnerName  String?
  brand        String?
  salesRepName String?
  value        Float
  stage        String
  pipelineId   String
  uploadedById String
  createdAt    DateTime @default(now())
  projectTitle String?
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
}

model NasModel {
  id                         String             @id @default(uuid())
  modelName                  String             @unique
  bays                       Int
  expansionUnitModel         String?
  expansionBaysPerUnit       Int                @default(0)
  maxExpansionUnitsSupported Int                @default(0)
  defaultRamGB               Float              @default(0)
  maxRamGB                   Float              @default(0)
  supportsSATA               Boolean            @default(true)
  supportsSAS                Boolean            @default(false)
  formFactor                 String
  powerType                  String
  networkPorts               String?
  series                     String?
  targetMarket               String?
  productId                  String?
  isActive                   Boolean            @default(true)
  createdAt                  DateTime           @default(now())
  updatedAt                  DateTime           @updatedAt
  compabilityItems           NasCompatibility[]
}

model NasCompatibility {
  id         String   @id @default(uuid())
  nasModelId String
  productId  String
  category   String
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  nasModel   NasModel @relation(fields: [nasModelId], references: [id], onDelete: Cascade)

  @@unique([nasModelId, productId])
}

model BuildRejection {
  id              String        @id @default(uuid())
  deliveryOrderId String
  inventoryItemId String
  serialNumber    String
  comment         String?
  rejectedById    String
  rejectedByName  String
  rejectedAt      DateTime      @default(now())
  dismissed       Boolean       @default(false)
  dismissedAt     DateTime?
  dismissedByName String?
  deliveryOrder   DeliveryOrder @relation(fields: [deliveryOrderId], references: [id], onDelete: Cascade)

  @@index([deliveryOrderId])
  @@index([inventoryItemId])
  @@index([serialNumber])
}
